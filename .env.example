# Local emulator (safe placeholders)
PORTAL_ENVIRONMENT=local
PORTAL_EXPECTED_PROJECT_ID=debageri-portal-dev
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=debageri-portal-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=debageri-portal-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=debageri-portal-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:portal
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server: prefer Application Default Credentials outside local development.
FIREBASE_ADMIN_PROJECT_ID=debageri-portal-dev
# FIREBASE_ADMIN_CLIENT_EMAIL=portal-runtime@debageri-portal-dev.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Production uses portal-specific values from Secret Manager/build settings.
# PORTAL_ENVIRONMENT=production
# PORTAL_EXPECTED_PROJECT_ID=debageri-portal-prod
