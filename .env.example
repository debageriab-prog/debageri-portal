# Local emulators only. This is not a real Google Cloud project.
PORTAL_ENVIRONMENT=local
PORTAL_EXPECTED_PROJECT_ID=debageri-portal-local
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=debageri-portal-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=debageri-portal-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=debageri-portal-local.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:portal
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server: prefer Application Default Credentials outside local development.
FIREBASE_ADMIN_PROJECT_ID=debageri-portal-local
# Production uses the Cloud Run service identity. Do not set a private key there.
# FIREBASE_ADMIN_CLIENT_EMAIL=portal-runtime@debageri-portal.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Production values are configured on Cloud Run and at image build time.
# PORTAL_ENVIRONMENT=production
# PORTAL_EXPECTED_PROJECT_ID=debageri-portal
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=debageri-portal
# FIREBASE_ADMIN_PROJECT_ID=debageri-portal
# NEXT_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
